{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YapLensResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detectedLanguage",
    "literalMeaning",
    "likelyIntents",
    "contextExplanation",
    "expectedNextAction",
    "misunderstandingRisk",
    "recommendedAction",
    "suggestedReplies",
    "confidence",
    "sources"
  ],
  "properties": {
    "detectedLanguage": {
      "type": "string"
    },
    "literalMeaning": {
      "type": "string"
    },
    "likelyIntents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "explanation"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "contextExplanation": {
      "type": "string"
    },
    "expectedNextAction": {
      "type": "string"
    },
    "misunderstandingRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommendedAction": {
      "type": "string"
    },
    "suggestedReplies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "text",
          "why"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "casual",
              "neutral",
              "academic",
              "very_respectful"
            ]
          },
          "text": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "reason"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "title",
          "url",
          "authorityLevel"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "authorityLevel": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        }
      }
    },
    "individualVariationCaveat": {
      "type": "string"
    }
  }
}
